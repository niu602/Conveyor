# Placeholders only. Copy to .env and fill in real values locally.
# .env is git-ignored; never commit a real key.

# Development LLM reverse proxy (courier-site/worker/llm-proxy.mjs).
# Read from the environment when the local desk starts. A visitor may instead paste
# their own provider key in the settings panel, which the proxy passes through.
# In M3 this moves to a dedicated Worker via `wrangler secret`.
ZHIPU_API_KEY=

# Minimum gap between upstream LLM calls, in milliseconds. The provider rate-limits by
# request density, not payload size. Pacing only: nothing is retried or altered.
LLM_PROXY_MIN_GAP_MS=8000

# Receipt signing key for M2-3 (WebCrypto). Local only, never committed.
# A P-256 private JWK as a single-line JSON object, including d. Generate one with:
#   node -e "import('./courier-site/receipt-crypto.js').then(async m=>console.log(JSON.stringify((await m.generateKeyPair()).privateJwk)))"
# The desk signs the booking facts once per job and publishes only the public half over
# /api/pubkey. Tests use a throwaway key pair; no real key is ever committed.
RECEIPT_PRIVATE_KEY=

# Public halves of retired signing keys, as a JSON array of JWKs (no d). Keep them here
# after a rotation so receipts signed with the old key still verify: each receipt names
# its own kid, and the reconciliation page picks the matching public key.
RECEIPT_RETIRED_PUBLIC_KEYS=[]