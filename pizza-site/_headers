# Cloudflare Pages headers for Little Oven Pizza.
#
# Only the public bundle files get Access-Control-Allow-Origin: *, so other agent sites
# and tools can read them. This mirrors what the skill's own serve_site.mjs sends locally.
#
# bridge/ deliberately gets no X-Frame-Options and no frame-ancestors policy: callers load
# bridge/action-bridge.html in a hidden frame. Pages sends neither by default, so the rule
# is to not add them. The bridge needs no CORS header.
#
# No page-wide Content-Security-Policy is set here on purpose. This site calls a partner
# site, so a CSP would have to allow the courier origin in connect-src and frame-src, and
# the LLM router in connect-src. Adding one is a deploy-day decision that must be followed
# by a real browser check of the chat and the partner call; an untested CSP breaks both.

/agent-manifest.json
  Access-Control-Allow-Origin: *

/little_oven_pizza.network.json
  Access-Control-Allow-Origin: *

/links.json
  Access-Control-Allow-Origin: *

/agent-mcp.json
  Access-Control-Allow-Origin: *

/.well-known/nsdeploy.json
  Access-Control-Allow-Origin: *

/.well-known/nsdeploy-agent.json
  Access-Control-Allow-Origin: *

/runtime/sandbox-worker.js
  Content-Security-Policy: default-src 'none'; script-src blob:; connect-src 'none'; worker-src 'none'